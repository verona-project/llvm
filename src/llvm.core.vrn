(base:external-function value-type "LLVMTypeOf" (t:value-ref) t:type-ref)

(base:external-function struct-element "LLVMStructGetTypeAtIndex" (t:type-ref u32) t:type-ref)

(base:external-function build-ret-void "LLVMBuildRetVoid" (t:builder-ref) t:value-ref)

(base:external-function function-get "LLVMGetNamedFunction" (t:module-ref (pointer u8)) t:value-ref)

; Borrowed use-list traversal. Do not mutate IR while retaining these handles.
(base:external-function first-use "LLVMGetFirstUse" (t:value-ref) t:use-ref)
(base:external-function next-use "LLVMGetNextUse" (t:use-ref) t:use-ref)
(base:external-function use-user "LLVMGetUser" (t:use-ref) t:value-ref)
