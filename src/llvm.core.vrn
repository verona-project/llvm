(base:external-function is-invoke "LLVMIsAInvokeInst" (t:value-ref) t:value-ref)
(base:external-function called-value "LLVMGetCalledValue" (t:value-ref) t:value-ref)

(base:external-function linkage-get "LLVMGetLinkage" (t:value-ref) i32)

